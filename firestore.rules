/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model and introduces data validation
 * based on a predefined schema. It also supports a "doctor" role for specific data access.
 *
 * Key Security Decisions:
 * - Strict Data Ownership: Users can only access data within their own document tree (`/users/{auth.uid}/...`).
 * - Schema Validation: All write operations (create/update) are validated against a set of schema functions,
 *   ensuring data integrity and preventing malformed data from being saved.
 * - Role-Based Access: A 'doctor' role is introduced, allowing read access to specific, relevant data
 *   (like assigned consultations) across different users, without granting broad permissions.
 * - Default Deny: All access is denied by default and only explicitly granted through specific rules.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions for Reusable Logic =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDoctor() {
      return isSignedIn() && get(/databases/$(database)/documents/roles_doctor/$(request.auth.uid)).data.role == 'doctor';
    }

    // ===== Schema Validation Functions =====

    function isValidUser(data) {
      return data.id == request.auth.uid &&
             data.email is string &&
             data.name is string &&
             data.dateJoined is timestamp;
    }

    function isValidVisionTestResult(data, userId) {
      return data.userId == userId &&
             data.testType is string &&
             data.testDate is timestamp &&
             data.score is number &&
             (!('notes' in data) || data.notes is string);
    }

    function isValidEyeExerciseLog(data, userId) {
        return data.userId == userId &&
               data.exerciseType is string &&
               data.exerciseDate is timestamp &&
               data.duration is number &&
               (!('repetitions' in data) || data.repetitions is number);
    }
    
    function isValidReminder(data, userId) {
        return data.userId == userId &&
               data.title is string &&
               data.time is string &&
               data.type is string && ['exercise', 'Eye Drops', 'Pill', 'Capsule', 'Liquid', 'appointment'].hasAny([data.type]) &&
               data.enabled is bool;
    }

    function isValidConsultation(data, userId) {
      return data.userId == userId &&
             data.doctorId is string &&
             data.patientName is string &&
             data.scheduledTime is string &&
             data.duration is number &&
             data.type is string && ['routine', 'follow_up', 'urgent', 'second_opinion'].hasAny([data.type]) &&
             data.status is string && ['scheduled', 'in_progress', 'completed', 'cancelled'].hasAny([data.status]) &&
             data.meetingLink is string &&
             (!('notes' in data) || data.notes is string);
    }

    // ===== Data Access Rules =====

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id; // ID is immutable
      allow delete: if isOwner(userId);
    }
    
    match /roles_doctor/{userId} {
      // Allow only doctors to read their own role document.
      allow get: if isOwner(userId) && isDoctor(); 
      allow list, create, update, delete: if false; // Roles managed externally
    }

    match /users/{userId}/visionTestResults/{visionTestResultId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidVisionTestResult(request.resource.data, userId);
    }
    
    match /users/{userId}/eyeExerciseLogs/{eyeExerciseLogId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidEyeExerciseLog(request.resource.data, userId);
    }

    match /users/{userId}/medicationReminders/{reminderId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidReminder(request.resource.data, userId);
    }
    
    match /users/{userId}/consultations/{consultationId} {
      // Patients can manage their own consultations
      allow get, list, create, update: if isOwner(userId) && isValidConsultation(request.resource.data, userId);
    }

    // Collection group match for doctors to view all consultations assigned to them.
    match /{path=**}/consultations/{consultationId} {
      // Allow a doctor to read a consultation if their ID is on the document.
      allow get: if isDoctor() && resource.data.doctorId == request.auth.uid;
    }
  }
}
