rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isDoctor() {
        return exists(/databases/$(database)/documents/roles_doctor/$(request.auth.uid));
    }
    
    function isDoctorForConsultation(consultationId) {
        let consultation = get(/databases/$(database)/documents/users/$(resource.data.userId)/consultations/$(consultationId)).data;
        return isDoctor() && consultation.doctorId == request.auth.uid;
    }

    // User Profiles
    match /users/{userId} {
      // Anyone can read a user's public profile
      allow get: if true;
      // Only the owner can create, update, or delete their profile
      allow write: if isOwner(userId);
    }
    
    // Reminders Subcollection
    match /users/{userId}/reminders/{reminderId} {
        // Only the owner can read or write their own reminders
        allow read, write: if isOwner(userId);
    }

    // Consultations Subcollection
    match /users/{userId}/consultations/{consultationId} {
        // A patient can access their own consultations.
        // The doctor assigned to the consultation can also access it.
        allow read, write: if isOwner(userId) || isDoctorForConsultation(consultationId);
    }

    // Doctor Roles
    match /roles_doctor/{userId} {
        // Any signed-in user can check if another user is a doctor.
        allow read: if isSignedIn();
        // Only backend processes should write to this collection. Disallow client-side writes.
        allow write: if false; 
    }
  }
}
