{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Visionary app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user.",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's full name."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        },
        "dateJoined": {
          "type": "string",
          "description": "Date and time when the user joined the app.",
          "format": "date-time"
        },
        "points": {
          "type": "number",
          "description": "Total points accumulated by the user."
        },
        "interests": {
          "type": "array",
          "description": "User's selected interests for content personalization.",
          "items": {
            "type": "string",
            "enum": [
              "strain_reduction",
              "vision_improvement",
              "preventative_care",
              "kids_health"
            ]
          }
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "dateJoined"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "type": "object",
      "description": "Logs a user's activity and points earned.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the log entry."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "activityType": {
          "type": "string",
          "description": "The type of activity performed (e.g., 'completed_test', 'completed_exercise')."
        },
        "activityName": {
          "type": "string",
          "description": "The name of the test or exercise."
        },
        "pointsEarned": {
          "type": "number",
          "description": "Points earned for this activity."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the activity was completed."
        }
      },
      "required": [
        "id",
        "userId",
        "activityType",
        "activityName",
        "pointsEarned",
        "timestamp"
      ]
    },
    "CheckupReport": {
      "title": "CheckupReport",
      "type": "object",
      "description": "Stores the results of a comprehensive check-up.",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testId": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "good",
                  "warning",
                  "danger"
                ]
              }
            },
            "required": [
              "testId",
              "value",
              "status"
            ]
          }
        }
      },
      "required": [
        "id",
        "date",
        "results"
      ]
    },
    "Reminder": {
      "title": "Reminder",
      "type": "object",
      "description": "Stores user-defined reminders for medications, exercises, or appointments.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "time"
        },
        "type": {
          "type": "string",
          "enum": [
            "exercise",
            "Eye Drops",
            "Pill",
            "Capsule",
            "Liquid",
            "appointment"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "dosage": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "appearance": {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string"
            },
            "color": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "userId",
        "title",
        "time",
        "type",
        "enabled"
      ]
    },
    "AdherenceLog": {
      "title": "AdherenceLog",
      "type": "object",
      "description": "Tracks when a user takes or misses a medication dose.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "reminderId": {
          "type": "string"
        },
        "medication": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Eye Drops",
            "Pill",
            "Capsule",
            "Liquid"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "taken",
            "skipped",
            "upcoming",
            "taken_late"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "reminderId",
        "medication",
        "type",
        "status",
        "timestamp"
      ]
    },
    "Consultation": {
      "title": "Consultation",
      "type": "object",
      "description": "Represents a telemedicine consultation between a user and a doctor.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "doctorId": {
          "type": "string"
        },
        "patientName": {
          "type": "string"
        },
        "scheduledTime": {
          "type": "string",
          "format": "date-time"
        },
        "duration": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": [
            "routine",
            "follow_up",
            "urgent",
            "second_opinion"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "meetingLink": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "doctorId",
        "patientName",
        "scheduledTime",
        "duration",
        "type",
        "status",
        "meetingLink"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com",
      "phone"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/users/{userId}/visionTestResults/{checkupReportId}": {
      "schema": {
        "$ref": "#/entities/CheckupReport"
      },
      "description": "Stores vision test checkup reports for a user."
    },
    "/users/{userId}/medicationReminders/{reminderId}": {
      "schema": {
        "$ref": "#/entities/Reminder"
      },
      "description": "Stores medication reminders for a specific user."
    },
    "/users/{userId}/adherenceLogs/{adherenceLogId}": {
      "schema": {
        "$ref": "#/entities/AdherenceLog"
      },
      "description": "Stores medication adherence logs for a user."
    },
    "/users/{userId}/consultations/{consultationId}": {
      "schema": {
        "$ref": "#/entities/Consultation"
      },
      "description": "Stores telemedicine consultations for a user."
    },
    "/users/{userId}/rewards/{activityLogId}": {
      "schema": {
        "$ref": "#/entities/ActivityLog"
      },
      "description": "Stores the activity log and points earned for a user."
    },
    "/roles_doctor/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "isDoctor": {
            "type": "boolean"
          }
        }
      },
      "description": "A collection to assign doctor roles to specific user IDs for role-based access control."
    }
  }
}